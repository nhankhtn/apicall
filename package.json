{
  "name": "apicall-runner",
  "version": "1.0.0",
  "description": "Self-hosted, Postman-compatible API client: collection runner, load testing, WebSocket, Socket.IO, MQTT and gRPC, with a Newman-style CLI.",
  "license": "MIT",
  "author": "Ngô Nguyễn Duy Nhân",
  "homepage": "https://github.com/nhankhtn/apicall#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhankhtn/apicall.git"
  },
  "bugs": {
    "url": "https://github.com/nhankhtn/apicall/issues"
  },
  "keywords": [
    "api-client",
    "postman",
    "postman-alternative",
    "newman",
    "collection-runner",
    "rest",
    "http-client",
    "load-testing",
    "websocket",
    "socket-io",
    "mqtt",
    "grpc",
    "self-hosted",
    "api-testing"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server.js\" \"vite\"",
    "build": "vite build",
    "start": "node server.js",
    "cli": "node bin/cli.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/search": "^6.7.2",
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@uiw/react-codemirror": "^4.23.6",
    "@vercel/functions": "^3.9.8",
    "ajv": "^8.17.1",
    "chai": "^4.5.0",
    "cheerio": "^1.0.0",
    "crypto-js": "^4.2.0",
    "fast-xml-parser": "^4.5.0",
    "handlebars": "^4.7.8",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mqtt": "5.16.0",
    "protobufjs": "8.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "4.8.4",
    "undici": "^7.16.0",
    "ws": "8.22.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  },
  "private": true,
  "type": "module",
  "bin": {
    "apicall": "bin/cli.mjs"
  }
}
